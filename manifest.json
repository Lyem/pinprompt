{
  "manifest_version": 3,
  "name": "Pinprompt: Point, Click & Prompt AI",
  "version": "1.0.1",
  "description": "Click any element on a page, say what to change, and copy a clean Markdown prompt for Claude, ChatGPT or any AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Pinprompt: start or stop selecting",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Start or stop selecting"
    }
  },
  "short_name": "Pinprompt"
}
